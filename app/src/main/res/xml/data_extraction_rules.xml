<?xml version="1.0" encoding="utf-8"?>
<!--
  Сохранение игры не должно попадать ни в облачную копию Google, ни в перенос между устройствами:
  иначе после удаления и переустановки приложения Android возвращает старый прогресс.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
